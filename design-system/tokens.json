{
  "$description": "Bridgify design tokens. Single source for the design system pages and tokens.css. Values decided by the owner on the Foundations board, 21 Nov 2026, unless marked status: provisional. Format follows the W3C Design Tokens draft ($value, $type, $description).",
  "meta": {
    "version": "0.1.0",
    "date": "2026-11-21",
    "board": "https://claude.ai/artifact/D4zymUxNfQpTzrDXHSu9Do"
  },
  "breakpoint": {
    "phone":   { "$type": "dimension", "$value": "0px",    "max": "599px",  "$description": "Phones. Reference width 390, check 360 and 430." },
    "tablet":  { "$type": "dimension", "$value": "600px",  "max": "1023px", "$description": "Tablets. Reference 768, check 834 and 1023." },
    "desktop": { "$type": "dimension", "$value": "1024px", "$description": "Desktop. Reference 1440, check 1024, 1280 and 1920." }
  },
  "grid": {
    "margin": {
      "phone":   { "$type": "dimension", "$value": "24px" },
      "tablet":  { "$type": "dimension", "$value": "32px" },
      "desktop": { "$type": "dimension", "$value": "max(clamp(40px, 4vw, 64px), (100vw - 1560px) / 2)", "$description": "Content is at most 1560px wide and centred: 58px margin at 1440, 180 at 1920." }
    },
    "content-max": { "$type": "dimension", "$value": "1560px" },
    "columns": { "phone": { "$value": 4 }, "tablet": { "$value": 8 }, "desktop": { "$value": 12 } }
  },
  "color": {
    "bg": {
      "base":  { "$type": "color", "$value": "#180F10", "$description": "Every dark section and the footer. One dark background; sections are separated by spacing and glass, not by a second shade." },
      "cream": { "$type": "color", "$value": "#EEE9DE", "$description": "Every light section. Cards on cream are separated by a hairline only." }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#EEE9DE", "$description": "Headings and primary text on dark. 15.6:1 on bg.base." },
      "strong":  { "$type": "color", "$value": "#FFF8F1", "$description": "Emphasised UI labels and numbers on dark, and text on a filled coral button. 17.9:1." },
      "body":    { "$type": "color", "$value": "#D7C9BD", "$description": "Running text on dark, including the footer. 11.6:1." },
      "muted":   { "$type": "color", "$value": "#B9A99F", "$description": "Dates, meta and quiet labels on dark. 8.3:1." },
      "on-light-head":  { "$type": "color", "$value": "#180F10", "$description": "Headings on cream. 15.6:1." },
      "on-light":       { "$type": "color", "$value": "#544440", "$description": "Running text on cream. 7.6:1." },
      "on-light-muted": { "$type": "color", "$value": "#6F625B", "$description": "Meta on cream. 4.85:1 (replaces #786B64, which failed AA)." }
    },
    "coral": {
      "500": { "$type": "color", "$value": "#F46649", "$description": "Brand coral. Frames, icons, dots, focus; on cream also links and coral text (owner decision: kept as today, 2.53:1 on cream, below AA for small text)." },
      "300": { "$type": "color", "$value": "#FFB194", "$description": "Links, Read more and step numbers on dark. 10.7:1." },
      "ink-dark":  { "$type": "gradient", "$value": "linear-gradient(90deg, #F46649 0%, #FF967B 23%, #FFE2C6 43%, #F88B72 60%, #F46649 78%, #FFB49A 100%)", "fallback": "#F48B73", "$description": "The second part of a two-part heading on dark." },
      "ink-light": { "$type": "gradient", "$value": "linear-gradient(90deg, #CF3F25 0%, #E5573A 30%, #E8603F 50%, #D9482C 72%, #CF3F25 100%)", "fallback": "#D9482C", "$description": "The second part of a two-part heading on cream (unchanged from DESIGN.md)." },
      "button": { "$type": "gradient", "$value": "linear-gradient(105deg, #FF9862, #F46649)", "$description": "Filled primary button. Component tokens follow on the Components board.", "status": "provisional" }
    },
    "state": {
      "success": { "$type": "color", "$value": "#63D99A", "$description": "System states only (live, done). Never a brand colour." },
      "warning": { "$type": "color", "$value": "#E3B25C" },
      "error":   { "$type": "color", "$value": "#E07A6A" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Chillax", "sans-serif"], "$description": "Headings and large numbers. Files: Chillax_Complete/Fonts (Light 300, Regular 400, Medium 500)." },
      "text":    { "$type": "fontFamily", "$value": ["Sofia Sans", "sans-serif"], "$description": "Everything else. One family name only (the site also used 'Sofia'). File: Sofia_Sans/SofiaSans-VariableFont_wght.ttf." },
      "code":    { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "$description": "Code windows only. No Arial, no Georgia." }
    }
  },
  "type": {
    "$description": "Each role gives desktop, tablet and phone. clamp() values are fluid between the breakpoints. Letter spacing in em.",
    "hero":       { "family": "display", "desktop": { "size": "clamp(40px, 3.6vw, 60px)", "weight": 300 }, "tablet": { "size": "40px", "weight": 300 }, "phone": { "size": "28px", "weight": 400 }, "lineHeight": 1.16, "letterSpacing": "-0.025em", "use": "The page title (h1)." },
    "section":    { "family": "display", "desktop": { "size": "clamp(36px, 3vw, 44px)", "weight": 300 }, "tablet": { "size": "36px", "weight": 300 }, "phone": { "size": "28px", "weight": 400 }, "lineHeight": 1.2, "letterSpacing": "-0.025em", "use": "Section titles." },
    "section-sm": { "family": "display", "desktop": { "size": "clamp(28px, 2.2vw, 32px)", "weight": 300 }, "tablet": { "size": "28px", "weight": 300 }, "phone": { "size": "28px", "weight": 400 }, "lineHeight": 1.2, "letterSpacing": "-0.02em", "use": "Frequently asked questions and the closing CTA at the end of every page." },
    "card":       { "family": "display", "desktop": { "size": "clamp(24px, 1.9vw, 28px)", "weight": 300 }, "tablet": { "size": "24px", "weight": 300 }, "phone": { "size": "24px", "weight": 300 }, "lineHeight": 1.25, "letterSpacing": "-0.02em", "use": "Card, panel and step titles." },
    "small-head": { "family": "display", "desktop": { "size": "20px", "weight": 300 }, "tablet": { "size": "20px", "weight": 300 }, "phone": { "size": "18px", "weight": 300 }, "lineHeight": 1.35, "letterSpacing": "-0.01em", "use": "FAQ questions, article titles, list item titles." },
    "stat":       { "family": "display", "desktop": { "size": "43px", "weight": 500 }, "tablet": { "size": "40px", "weight": 500 }, "phone": { "size": "36px", "weight": 500 }, "lineHeight": 1, "letterSpacing": "-0.02em", "use": "Large numbers (1M+, 3x). Weight 500 is reserved for numbers.", "status": "provisional" },
    "body":       { "family": "text", "desktop": { "size": "16px", "weight": 400 }, "tablet": { "size": "16px", "weight": 400 }, "phone": { "size": "16px", "weight": 400 }, "lineHeight": 1.55, "letterSpacing": "0", "use": "Running text and intros. Never below 16." },
    "small":      { "family": "text", "desktop": { "size": "14px", "weight": 400 }, "tablet": { "size": "14px", "weight": 400 }, "phone": { "size": "14px", "weight": 400 }, "lineHeight": 1.5, "letterSpacing": "0", "use": "Card descriptions, notes." },
    "cta":        { "family": "text", "desktop": { "size": "16px", "weight": 550 }, "tablet": { "size": "16px", "weight": 550 }, "phone": { "size": "16px", "weight": 550 }, "lineHeight": 1.25, "letterSpacing": "0", "use": "Buttons and text links." },
    "eyebrow":    { "family": "text", "desktop": { "size": "12px", "weight": 550 }, "tablet": { "size": "12px", "weight": 550 }, "phone": { "size": "12px", "weight": 550 }, "lineHeight": 1.4, "letterSpacing": "0.15em", "transform": "uppercase", "use": "Section label above a title, with the 7px coral dot." },
    "nav":        { "family": "text", "desktop": { "size": "12px", "weight": 550 }, "tablet": { "size": "12px", "weight": 550 }, "phone": { "size": "12px", "weight": 550 }, "lineHeight": 1.3, "letterSpacing": "0.08em", "transform": "uppercase", "use": "Header menu, footer column titles and footer links." },
    "index":      { "family": "text", "desktop": { "size": "13px", "weight": 600 }, "tablet": { "size": "13px", "weight": 600 }, "phone": { "size": "13px", "weight": 600 }, "lineHeight": 1.3, "letterSpacing": "0.04em", "numeric": "tabular-nums", "use": "Step numbers 01, 02, 03." },
    "caption":    { "family": "text", "desktop": { "size": "12px", "weight": 400 }, "tablet": { "size": "12px", "weight": 400 }, "phone": { "size": "12px", "weight": 400 }, "lineHeight": 1.4, "letterSpacing": "0", "use": "Dates, copyright, Back to top. Nothing outside illustrations is smaller than 12." }
  },
  "rule": {
    "illustration-text-min": { "$type": "dimension", "$value": "10px", "$description": "Text inside illustrations (phone screens, diagrams, windows) scales with the art but is never smaller than 10px as seen. If it does not fit, shorten the illustration or show part of it." }
  },
  "space": {
    "$description": "Approved 17 Nov 2026 (SPACING-GRID-PLAN.md, MOBILE-RULES.md). Phone values are the mobile layer's spacing table.",
    "section-y":        { "phone": "64px", "tablet": "80px", "desktop": "96px", "use": "Top and bottom of every section." },
    "hero-top":         { "phone": "48px", "tablet": "64px", "desktop": "80px", "use": "Header bar to the hero label." },
    "gap-label-title":  { "phone": "16px", "tablet": "16px", "desktop": "24px", "use": "Eyebrow to title." },
    "gap-title-text":   { "phone": "24px", "tablet": "24px", "desktop": "32px", "use": "Title to intro." },
    "gap-title-sub":    { "phone": "8px",  "tablet": "8px",  "desktop": "8px",  "use": "Title to its subtitle." },
    "gap-text-text":    { "phone": "16px", "tablet": "16px", "desktop": "16px", "use": "Paragraph to paragraph." },
    "gap-text-more":    { "phone": "8px",  "tablet": "8px",  "desktop": "8px",  "use": "Text to Read more." },
    "gap-to-actions":   { "phone": "32px", "tablet": "40px", "desktop": "48px", "use": "Text to buttons." },
    "gap-actions-inner":{ "phone": "12px", "tablet": "12px", "desktop": "16px", "use": "Button to button." },
    "gap-to-link":      { "phone": "16px", "tablet": "16px", "desktop": "24px", "use": "Text or buttons to a text link." },
    "gap-to-control":   { "phone": "32px", "tablet": "40px", "desktop": "48px", "use": "Heading to tabs or a stepper." },
    "gap-control-content": { "phone": "16px", "tablet": "24px", "desktop": "32px", "use": "Tabs to their content." },
    "gap-to-content":   { "phone": "32px", "tablet": "48px", "desktop": "64px", "use": "Heading to the section content." },
    "gap-to-visual":    { "phone": "48px", "tablet": "64px", "desktop": "64px", "use": "Hero heading to the hero visual." },
    "gap-to-foot":      { "phone": "24px", "tablet": "32px", "desktop": "32px", "use": "Content to a section's closing line." },
    "card-gap":         { "phone": "16px", "tablet": "24px", "desktop": "32px", "use": "Between cards." },
    "card-pad":         { "phone": "20px", "tablet": "24px", "desktop": "32px", "use": "Inside a card." }
  }
}
