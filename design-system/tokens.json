{
  "$description": "Bridgify design tokens. Single source for the design system pages and tokens.css. Values decided by the owner on the Foundations board, 21 Nov 2026, unless marked status: provisional. Format follows the W3C Design Tokens draft ($value, $type, $description).",
  "meta": {
    "version": "0.2.0",
    "date": "2026-11-21",
    "board": "https://claude.ai/artifact/D4zymUxNfQpTzrDXHSu9Do",
    "boards": [
      "https://claude.ai/artifact/D4zymUxNfQpTzrDXHSu9Do",
      "https://claude.ai/artifact/21upXMG57TyfQPnXTDm6Gc"
    ]
  },
  "breakpoint": {
    "phone": {
      "$type": "dimension",
      "$value": "0px",
      "max": "599px",
      "$description": "Phones. Reference width 390, check 360 and 430."
    },
    "tablet": {
      "$type": "dimension",
      "$value": "600px",
      "max": "1023px",
      "$description": "Tablets. Reference 768, check 834 and 1023."
    },
    "desktop": {
      "$type": "dimension",
      "$value": "1024px",
      "$description": "Desktop. Reference 1440, check 1024, 1280 and 1920."
    }
  },
  "grid": {
    "margin": {
      "phone": {
        "$type": "dimension",
        "$value": "24px"
      },
      "tablet": {
        "$type": "dimension",
        "$value": "32px"
      },
      "desktop": {
        "$type": "dimension",
        "$value": "max(clamp(40px, 4vw, 64px), (100vw - 1560px) / 2)",
        "$description": "Content is at most 1560px wide and centred: 58px margin at 1440, 180 at 1920."
      }
    },
    "content-max": {
      "$type": "dimension",
      "$value": "1560px"
    },
    "columns": {
      "phone": {
        "$value": 4
      },
      "tablet": {
        "$value": 8
      },
      "desktop": {
        "$value": 12
      }
    }
  },
  "color": {
    "bg": {
      "base": {
        "$type": "color",
        "$value": "#180F10",
        "$description": "Every dark section and the footer. One dark background; sections are separated by spacing and glass, not by a second shade."
      },
      "cream": {
        "$type": "color",
        "$value": "#EEE9DE",
        "$description": "Every light section. Cards on cream are separated by a hairline only."
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#EEE9DE",
        "$description": "Headings and primary text on dark. 15.6:1 on bg.base."
      },
      "strong": {
        "$type": "color",
        "$value": "#FFF8F1",
        "$description": "Emphasised UI labels and numbers on dark, and text on a filled coral button. 17.9:1."
      },
      "body": {
        "$type": "color",
        "$value": "#D7C9BD",
        "$description": "Running text on dark, including the footer. 11.6:1."
      },
      "muted": {
        "$type": "color",
        "$value": "#B9A99F",
        "$description": "Dates, meta and quiet labels on dark. 8.3:1."
      },
      "on-light-head": {
        "$type": "color",
        "$value": "#180F10",
        "$description": "Headings on cream. 15.6:1."
      },
      "on-light": {
        "$type": "color",
        "$value": "#544440",
        "$description": "Running text on cream. 7.6:1."
      },
      "on-light-muted": {
        "$type": "color",
        "$value": "#6F625B",
        "$description": "Meta on cream. 4.85:1 (replaces #786B64, which failed AA)."
      }
    },
    "coral": {
      "500": {
        "$type": "color",
        "$value": "#F46649",
        "$description": "Brand coral. Frames, icons, dots, focus; on cream also links and coral text (owner decision: kept as today, 2.53:1 on cream, below AA for small text)."
      },
      "300": {
        "$type": "color",
        "$value": "#FFB194",
        "$description": "Links, Read more and step numbers on dark. 10.7:1."
      },
      "ink-dark": {
        "$type": "gradient",
        "$value": "linear-gradient(90deg, #F46649 0%, #FF967B 23%, #FFE2C6 43%, #F88B72 60%, #F46649 78%, #FFB49A 100%)",
        "fallback": "#F48B73",
        "$description": "The second part of a two-part heading on dark."
      },
      "ink-light": {
        "$type": "gradient",
        "$value": "linear-gradient(90deg, #CF3F25 0%, #E5573A 30%, #E8603F 50%, #D9482C 72%, #CF3F25 100%)",
        "fallback": "#D9482C",
        "$description": "The second part of a two-part heading on cream (unchanged from DESIGN.md)."
      },
      "button": {
        "$type": "gradient",
        "$value": "linear-gradient(105deg, #FF9862, #F46649)",
        "$description": "Filled primary button, resting. Hover: linear-gradient(105deg, #FFAD80, #F7704F)."
      }
    },
    "state": {
      "success": {
        "$type": "color",
        "$value": "#63D99A",
        "$description": "System states only (live, done). Never a brand colour."
      },
      "warning": {
        "$type": "color",
        "$value": "#E3B25C"
      },
      "error": {
        "$type": "color",
        "$value": "#E07A6A"
      }
    },
    "line": {
      "quiet": {
        "$type": "color",
        "$value": "rgba(238,233,222,0.18)",
        "$description": "Edge of a quiet card and FAQ row lines on dark."
      },
      "glass": {
        "$type": "color",
        "$value": "rgba(246,200,181,0.58)",
        "$description": "Peach edge of a glass surface."
      },
      "on-light": {
        "$type": "color",
        "$value": "rgba(24,15,16,0.15)",
        "$description": "Hairlines on cream."
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Chillax",
          "sans-serif"
        ],
        "$description": "Headings and large numbers. Files: Chillax_Complete/Fonts (Light 300, Regular 400, Medium 500)."
      },
      "text": {
        "$type": "fontFamily",
        "$value": [
          "Sofia Sans",
          "sans-serif"
        ],
        "$description": "Everything else. One family name only (the site also used 'Sofia'). File: Sofia_Sans/SofiaSans-VariableFont_wght.ttf."
      },
      "code": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "Code windows only. No Arial, no Georgia."
      }
    }
  },
  "type": {
    "$description": "Each role gives desktop, tablet and phone. clamp() values are fluid between the breakpoints. Letter spacing in em.",
    "hero": {
      "family": "display",
      "desktop": {
        "size": "clamp(40px, 3.6vw, 60px)",
        "weight": 300
      },
      "tablet": {
        "size": "40px",
        "weight": 300
      },
      "phone": {
        "size": "28px",
        "weight": 400
      },
      "lineHeight": 1.16,
      "letterSpacing": "-0.025em",
      "use": "The page title (h1)."
    },
    "section": {
      "family": "display",
      "desktop": {
        "size": "clamp(36px, 3vw, 44px)",
        "weight": 300
      },
      "tablet": {
        "size": "36px",
        "weight": 300
      },
      "phone": {
        "size": "28px",
        "weight": 400
      },
      "lineHeight": 1.2,
      "letterSpacing": "-0.025em",
      "use": "Section titles."
    },
    "section-sm": {
      "family": "display",
      "desktop": {
        "size": "clamp(28px, 2.2vw, 32px)",
        "weight": 300
      },
      "tablet": {
        "size": "28px",
        "weight": 300
      },
      "phone": {
        "size": "28px",
        "weight": 400
      },
      "lineHeight": 1.2,
      "letterSpacing": "-0.02em",
      "use": "Frequently asked questions and the closing CTA at the end of every page."
    },
    "card": {
      "family": "display",
      "desktop": {
        "size": "clamp(24px, 1.9vw, 28px)",
        "weight": 300
      },
      "tablet": {
        "size": "24px",
        "weight": 300
      },
      "phone": {
        "size": "24px",
        "weight": 300
      },
      "lineHeight": 1.25,
      "letterSpacing": "-0.02em",
      "use": "Card, panel and step titles."
    },
    "small-head": {
      "family": "display",
      "desktop": {
        "size": "20px",
        "weight": 300
      },
      "tablet": {
        "size": "20px",
        "weight": 300
      },
      "phone": {
        "size": "18px",
        "weight": 300
      },
      "lineHeight": 1.35,
      "letterSpacing": "-0.01em",
      "use": "FAQ questions, article titles, list item titles."
    },
    "stat": {
      "family": "display",
      "desktop": {
        "size": "43px",
        "weight": 500
      },
      "tablet": {
        "size": "40px",
        "weight": 500
      },
      "phone": {
        "size": "36px",
        "weight": 500
      },
      "lineHeight": 1,
      "letterSpacing": "-0.02em",
      "use": "Large numbers (1M+, 3x). Weight 500 is reserved for numbers.",
      "status": "provisional"
    },
    "body": {
      "family": "text",
      "desktop": {
        "size": "16px",
        "weight": 400
      },
      "tablet": {
        "size": "16px",
        "weight": 400
      },
      "phone": {
        "size": "16px",
        "weight": 400
      },
      "lineHeight": 1.55,
      "letterSpacing": "0",
      "use": "Running text and intros. Never below 16."
    },
    "small": {
      "family": "text",
      "desktop": {
        "size": "14px",
        "weight": 400
      },
      "tablet": {
        "size": "14px",
        "weight": 400
      },
      "phone": {
        "size": "14px",
        "weight": 400
      },
      "lineHeight": 1.5,
      "letterSpacing": "0",
      "use": "Card descriptions, notes."
    },
    "cta": {
      "family": "text",
      "desktop": {
        "size": "16px",
        "weight": 550
      },
      "tablet": {
        "size": "16px",
        "weight": 550
      },
      "phone": {
        "size": "16px",
        "weight": 550
      },
      "lineHeight": 1.25,
      "letterSpacing": "0",
      "use": "Buttons and text links."
    },
    "eyebrow": {
      "family": "text",
      "desktop": {
        "size": "12px",
        "weight": 550
      },
      "tablet": {
        "size": "12px",
        "weight": 550
      },
      "phone": {
        "size": "12px",
        "weight": 550
      },
      "lineHeight": 1.4,
      "letterSpacing": "0.15em",
      "transform": "uppercase",
      "use": "Section label above a title, with the 7px coral dot."
    },
    "nav": {
      "family": "text",
      "desktop": {
        "size": "12px",
        "weight": 550
      },
      "tablet": {
        "size": "12px",
        "weight": 550
      },
      "phone": {
        "size": "12px",
        "weight": 550
      },
      "lineHeight": 1.3,
      "letterSpacing": "0.08em",
      "transform": "uppercase",
      "use": "Header menu, footer column titles and footer links."
    },
    "index": {
      "family": "text",
      "desktop": {
        "size": "13px",
        "weight": 600
      },
      "tablet": {
        "size": "13px",
        "weight": 600
      },
      "phone": {
        "size": "13px",
        "weight": 600
      },
      "lineHeight": 1.3,
      "letterSpacing": "0.04em",
      "numeric": "tabular-nums",
      "use": "Step numbers 01, 02, 03."
    },
    "caption": {
      "family": "text",
      "desktop": {
        "size": "12px",
        "weight": 400
      },
      "tablet": {
        "size": "12px",
        "weight": 400
      },
      "phone": {
        "size": "12px",
        "weight": 400
      },
      "lineHeight": 1.4,
      "letterSpacing": "0",
      "use": "Dates, copyright, Back to top. Nothing outside illustrations is smaller than 12."
    }
  },
  "rule": {
    "illustration-text-min": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "Text inside illustrations (phone screens, diagrams, windows) scales with the art but is never smaller than 10px as seen. If it does not fit, shorten the illustration or show part of it."
    }
  },
  "space": {
    "$description": "Approved 17 Nov 2026 (SPACING-GRID-PLAN.md, MOBILE-RULES.md). Phone values are the mobile layer's spacing table.",
    "section-y": {
      "phone": "64px",
      "tablet": "80px",
      "desktop": "96px",
      "use": "Top and bottom of every section."
    },
    "hero-top": {
      "phone": "48px",
      "tablet": "64px",
      "desktop": "80px",
      "use": "Header bar to the hero label."
    },
    "gap-label-title": {
      "phone": "16px",
      "tablet": "16px",
      "desktop": "24px",
      "use": "Eyebrow to title."
    },
    "gap-title-text": {
      "phone": "24px",
      "tablet": "24px",
      "desktop": "32px",
      "use": "Title to intro."
    },
    "gap-title-sub": {
      "phone": "8px",
      "tablet": "8px",
      "desktop": "8px",
      "use": "Title to its subtitle."
    },
    "gap-text-text": {
      "phone": "16px",
      "tablet": "16px",
      "desktop": "16px",
      "use": "Paragraph to paragraph."
    },
    "gap-text-more": {
      "phone": "8px",
      "tablet": "8px",
      "desktop": "8px",
      "use": "Text to Read more."
    },
    "gap-to-actions": {
      "phone": "32px",
      "tablet": "40px",
      "desktop": "48px",
      "use": "Text to buttons."
    },
    "gap-actions-inner": {
      "phone": "12px",
      "tablet": "12px",
      "desktop": "16px",
      "use": "Button to button."
    },
    "gap-to-link": {
      "phone": "16px",
      "tablet": "16px",
      "desktop": "24px",
      "use": "Text or buttons to a text link."
    },
    "gap-to-control": {
      "phone": "32px",
      "tablet": "40px",
      "desktop": "48px",
      "use": "Heading to tabs or a stepper."
    },
    "gap-control-content": {
      "phone": "16px",
      "tablet": "24px",
      "desktop": "32px",
      "use": "Tabs to their content."
    },
    "gap-to-content": {
      "phone": "32px",
      "tablet": "48px",
      "desktop": "64px",
      "use": "Heading to the section content."
    },
    "gap-to-visual": {
      "phone": "48px",
      "tablet": "64px",
      "desktop": "64px",
      "use": "Hero heading to the hero visual."
    },
    "gap-to-foot": {
      "phone": "24px",
      "tablet": "32px",
      "desktop": "32px",
      "use": "Content to a section's closing line."
    },
    "card-gap": {
      "phone": "16px",
      "tablet": "24px",
      "desktop": "32px",
      "use": "Between cards."
    },
    "card-pad": {
      "phone": "20px",
      "tablet": "24px",
      "desktop": "32px",
      "use": "Inside a card."
    }
  },
  "radius": {
    "$description": "Owner decision 21 Nov 2026: 12 / 18 / 30 / pill. Buttons keep their own 10px (decided separately).",
    "sm": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Inputs, small tiles, images inside cards."
    },
    "md": {
      "$type": "dimension",
      "$value": "18px",
      "$description": "Cards."
    },
    "lg": {
      "$type": "dimension",
      "$value": "30px",
      "$description": "Large panels, stages, the closing CTA card."
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px",
      "$description": "Chips and filters."
    },
    "button": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "Every button, including the header buttons."
    }
  },
  "shadow": {
    "none": {
      "$type": "shadow",
      "$value": "none",
      "$description": "Quiet cards."
    },
    "soft": {
      "$type": "shadow",
      "$value": "0 24px 60px rgba(0,0,0,0.4)",
      "$description": "Glass surfaces."
    },
    "glow": {
      "$type": "shadow",
      "$value": "0 0 46px rgba(244,102,73,0.2), 0 24px 60px rgba(0,0,0,0.4)",
      "$description": "Reserved: one featured element per screen at most (for example a hero visual). Not part of the glass recipe."
    }
  },
  "glass": {
    "$description": "The soft glass recipe (owner decision: no outer glow).",
    "background": {
      "$value": "radial-gradient(at 100% 0%, rgba(255,137,98,0.18), transparent 30%), radial-gradient(at 0% 100%, rgba(255,120,83,0.17), transparent 26%), linear-gradient(115deg, rgba(255,248,241,0.05), transparent 40%, rgba(255,248,241,0.03)), rgba(20,13,11,0.95)"
    },
    "border": {
      "$value": "1px solid rgba(246,200,181,0.58)"
    },
    "inner": {
      "$value": "inset 0 1px 1px rgba(255,241,218,0.58), inset 0 -1px 1px rgba(255,153,123,0.46)",
      "$description": "Rim light, top and bottom."
    },
    "shadow": {
      "$value": "shadow.soft"
    },
    "blur": {
      "$value": "blur(12px)",
      "$description": "backdrop-filter, only where the glass sits over imagery."
    }
  },
  "component": {
    "button": {
      "use": "Actions. Primary: one per group, filled coral. Secondary: transparent with a coral edge. Same shapes on dark and on cream; on cream the secondary text is #180F10.",
      "height": {
        "desktop": "52px",
        "tablet": "48px",
        "phone": "40px"
      },
      "tapArea": "44px on phone (an invisible area around the 40px button)",
      "paddingInline": {
        "desktop": "24px",
        "tablet": "22px",
        "phone": "18px"
      },
      "gap": "10px between label and arrow",
      "radius": "radius.button (10px)",
      "border": "1px",
      "type": "type.cta (16 / 550)",
      "arrow": "Always ↗, after the label (owner decision). No ↘, →, or arrow square.",
      "group": "Buttons in one group share one width on phone and sit 12px apart (space.gap-actions-inner).",
      "states": {
        "primary": {
          "rest": "bg color.coral.button, text #180F10, border coral 500, inset 0 1px 1px rgba(255,217,194,0.53)",
          "hover / focus": "bg linear-gradient(105deg, #FFAD80, #F7704F), shadow 0 12px 28px rgba(244,102,73,0.25)",
          "pressed": "translateY(1px)",
          "disabled": "opacity 0.4, no pointer"
        },
        "secondary": {
          "rest": "transparent, border coral 500, text #FFF8F1 (on cream #180F10)",
          "hover / focus": "bg rgba(244,102,73,0.1), text unchanged",
          "pressed": "translateY(1px)",
          "disabled": "opacity 0.4"
        },
        "focus": "2px solid coral 500 outline, 4px offset (keyboard only)"
      }
    },
    "header-button": {
      "use": "LOG IN (secondary) and BOOK A DEMO ↗ (primary) in the header, on every device.",
      "height": {
        "desktop": "36px",
        "tablet": "36px",
        "phone": "36px"
      },
      "paddingInline": "16px",
      "radius": "radius.button (10px)",
      "type": "type.nav (12 / 550, uppercase, 0.08em)"
    },
    "link": {
      "use": "Go to another page or read more. Never drawn as a button.",
      "type": "type.cta (16 / 550)",
      "color": "coral 300 on dark, coral 500 on cream",
      "underline": "Always: 1px, offset 5px (owner decision)",
      "arrow": "↗ after the label",
      "states": {
        "hover / focus": "colour warms to #FFE2C6 on dark; the arrow steps 3px up and right"
      }
    },
    "chip": {
      "use": "Filters and categories (blog, press, map filters).",
      "height": {
        "desktop": "40px",
        "tablet": "40px",
        "phone": "40px"
      },
      "paddingInline": "16px",
      "radius": "radius.pill",
      "type": "14 / 550 Sofia Sans",
      "states": {
        "rest": "transparent, border line.glass, text #EEE9DE",
        "selected": "bg color.coral.button, text #180F10, border coral 500",
        "hover": "border coral 500"
      }
    },
    "card-quiet": {
      "use": "Lists and grids of equal items.",
      "radius": "radius.md (18px)",
      "border": "1px line.quiet",
      "background": "linear-gradient(125deg, rgba(238,233,222,0.016), rgba(33,26,24,0.11))",
      "shadow": "shadow.none",
      "padding": {
        "desktop": "32px",
        "tablet": "24px",
        "phone": "20px"
      }
    },
    "card-glass": {
      "use": "Featured panels and the frames around illustrations. No solid coral frames anywhere (owner decision).",
      "radius": "radius.md (18px); large panels radius.lg (30px)",
      "recipe": "glass",
      "padding": {
        "desktop": "32px",
        "tablet": "24px",
        "phone": "20px"
      }
    },
    "stepper": {
      "use": "Scroll-linked steps (Why Bridgify, Hotels stay, API customer experience). One style everywhere: number and a small uppercase label (owner decision).",
      "row": {
        "height": "48px",
        "gap": "2px between rows",
        "paddingInline": "14px"
      },
      "number": "type.index (13 / 600), coral 300",
      "label": "13 / 550 Sofia Sans, uppercase, 0.12em; #A99D94 at rest, #FFF8F1 when active",
      "track": "2px on the start edge, rgba(178,138,104,0.24); fills with coral 500 as the step plays",
      "phone": "Steps stack above their preview; no pinning below 901px wide."
    },
    "tabs": {
      "use": "Parallel content inside a section or illustration. Segmented control (owner decision).",
      "container": "1px line.quiet, radius 12px, padding 4px, gap 4px",
      "tab": {
        "height": "40px",
        "paddingInline": "16px",
        "radius": "9px",
        "type": "15 / 550 Sofia Sans"
      },
      "states": {
        "rest": "transparent, text #D7C9BD",
        "selected": "bg color.coral.button, text #180F10",
        "hover": "text #EEE9DE"
      }
    },
    "faq": {
      "use": "Frequently asked questions on every page.",
      "row": "1px top line line.quiet; padding 20px 0",
      "question": "type.small-head (20 desktop / 18 phone, Chillax 300)",
      "icon": "+ in coral 500, turns to − when open",
      "answer": "type.body, color text.body, max 68ch",
      "behaviour": "Several can be open. Opens on click and on Enter or Space."
    },
    "icon": {
      "use": "Line icons in the Bridgify set.",
      "size": {
        "list": "24px",
        "feature": "32px"
      },
      "stroke": "1.5px coral 500, round caps and joins",
